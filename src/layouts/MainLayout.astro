---
import { getLocale, getPagePath } from '@/functions/getLocale'
import Default from '@/layouts/Default.astro'
import AnimatedLink from '@/components/AnimatedLink.astro'
import SideSection from '@/partials/SideSection.astro'
import useTranslations from '@/functions/useTranslations'
const locale = getLocale(Astro.url)
const { t } = await useTranslations(locale)
const localized = (path: string) =>
  locale === 'en' ? path : '/' + locale + (path === '/' ? '' : path)
const pagePath = getPagePath(Astro.url)
const pathname = localized(pagePath === '/tests' ? '/projects' : pagePath)
const tabs = [
  { href: '/', name: t('Tabs.profile') },
  { href: '/projects', name: t('Tabs.projects') },
  { href: '/skills', name: t('Tabs.skills') },
  { href: '/score', name: t('Tabs.score') }
]
---

<Default>
  <a
    class="skip-link absolute top-[-100px] left-4 z-100 bg-white px-4 py-[0.7rem] text-teal-900 focus:top-4"
    href="#main-content"
  >
    {t('skip')}
  </a>
  <div class="site-shell mx-auto max-w-[1440px] lg:grid lg:min-h-screen lg:grid-cols-[320px_minmax(0,1fr)]">
    <SideSection />
    <main class="site-main min-w-0 px-6 pt-8 pb-16 lg:px-14" id="main-content" tabindex="-1">
      <nav
        id="main-nav-tabs"
        class="main-nav flex flex-wrap gap-x-6 gap-y-3 border-b border-stone-300 lg:gap-x-10 dark:border-slate-700"
        aria-label={t('navigation')}
      >
        {tabs.map((tab) => (
          <AnimatedLink
            variant="tab"
            label={tab.name}
            href={localized(tab.href)}
            data-active={pathname === localized(tab.href)}
            aria-current={pathname === localized(tab.href) ? 'page' : undefined}
          />
        ))}
      </nav>
      <div class="page-content pt-10">
        <slot />
      </div>
    </main>
  </div>
</Default>

<script>
  // Astro runs this module once. Delegation keeps it working after every page swap.
  document.addEventListener('click', (event) => {
    const target = event.target
    if (
      target instanceof Element &&
      target.closest('#main-nav-tabs a') &&
      window.innerWidth < 1024
    ) {
      try {
        sessionStorage.setItem('scroll-to-tabs', 'true')
      } catch {
        /* Navigation still works when storage is unavailable. */
      }
    }
  })
  document.addEventListener('astro:page-load', () => {
    try {
      if (sessionStorage.getItem('scroll-to-tabs') === 'true') {
        document.getElementById('main-nav-tabs')?.scrollIntoView({ behavior: 'instant' })
        sessionStorage.removeItem('scroll-to-tabs')
      }
    } catch {
      /* Storage is optional. */
    }
  })
</script>
