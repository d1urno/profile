---
import { getLocale } from '@/functions/getLocale'
import { getCollection, render } from 'astro:content'
import ExperienceItem from '@/components/ExperienceItem.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import useTranslations from '@/functions/useTranslations'
const locale = getLocale(Astro.url)
interface Props {
  resume?: boolean
  embedded?: boolean
}
const { resume = false, embedded = false } = Astro.props
const nested = resume || embedded
const Heading = nested ? 'h2' : 'h1'
const { t } = await useTranslations(locale)
const experiences = (
  await getCollection('experiences', ({ id }) => id.startsWith(locale + '/'))
).sort((a, b) => a.data.order - b.data.order)
---

<section aria-labelledby="experience-heading">
  <SectionHeading as={Heading} id="experience-heading">
    {t('ExperiencesSection.title')}
  </SectionHeading>
  {experiences.map(async (experience) => {
    const { Content } = await render(experience)
    return (
      <ExperienceItem experience={experience.data} resume={nested}>
        <Content />
      </ExperienceItem>
    )
  })}
</section>
