---
import { getLocale } from '@/functions/getLocale'
import useTranslations from '@/functions/useTranslations'
import { getProjects } from '@/data/projects'
import ProjectCard from '@/components/ProjectCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
const locale = getLocale(Astro.url)
const { t } = await useTranslations(locale)
const projects = getProjects(locale).slice(0, compact ? 2 : undefined)
const thumbnailLabel = { en: 'Preview of', es: 'Vista previa de', pt: 'Prévia de' }[locale]
---

<section aria-labelledby="projects-heading">
  <SectionHeading as={compact ? 'h2' : 'h1'} id="projects-heading" hidden>
    {t('projectTitle')}
  </SectionHeading>
  <div class="project-list grid gap-6">
    {projects.map((project) => (
      <ProjectCard project={project} thumbnailLabel={thumbnailLabel} compact={compact} />
    ))}
  </div>
</section>
