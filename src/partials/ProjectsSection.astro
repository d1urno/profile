---
import { getLocale } from '@/functions/getLocale'
import useTranslations from '@/functions/useTranslations'
import { Image } from 'astro:assets'
import traceCdrThumbnail from '@/assets/projects/trace-cdr.png'
import dogAndPonyThumbnail from '@/assets/projects/dog-and-pony.png'
import doc88Thumbnail from '@/assets/projects/doc88.png'
const locale = getLocale(Astro.url) as 'en' | 'es' | 'pt'
const { t } = await useTranslations(locale)
interface Props {
  compact?: boolean
}
const { compact = false } = Astro.props
const projects = {
  en: [
    [
      'Historical open source · 2020',
      'Nuxt image extractor',
      'Built a Nuxt module for statically generated sites. It downloads images from a CMS and rewrites page references to local assets. Created for the Matera website workflow; the repository is now archived.',
      'Nuxt · Node.js · Static generation',
      'Source and documentation'
    ],
    [
      'Public demo · 2025',
      'Trace CDR',
      'An interactive data visualization demo using React, d3.js and TanStack Query. Explore the interface in the public preview.',
      'React 19 · TypeScript · Tailwind CSS · d3.js · TanStack Query',
      'Open demo'
    ],
    [
      'Frontend challenge · 2020',
      'Dog & Pony Studios',
      'A frontend implementation exercise using Nuxt, Tailwind CSS and Jest.',
      'Nuxt · Tailwind CSS · Jest',
      'Open preview'
    ],
    [
      'Frontend challenge · 2020',
      'Doc88',
      'A frontend implementation exercise using Vue, TypeScript, Tailwind CSS and Jest.',
      'Vue 2.6 · TypeScript · Tailwind CSS · Jest',
      'Open preview'
    ]
  ],
  es: [
    [
      'Código abierto histórico · 2020',
      'Nuxt image extractor',
      'Desarrollé un módulo de Nuxt para sitios estáticos. Descarga imágenes de un CMS y actualiza las referencias de las páginas a archivos locales. Creado para el proyecto de Matera; el repositorio está archivado.',
      'Nuxt · Node.js · Generación estática',
      'Código y documentación'
    ],
    [
      'Demo pública · 2025',
      'Trace CDR',
      'Demo interactiva de visualización de datos con React, d3.js y TanStack Query. Explora la interfaz en la vista previa pública.',
      'React 19 · TypeScript · Tailwind CSS · d3.js · TanStack Query',
      'Abrir demo'
    ],
    [
      'Desafío frontend · 2020',
      'Dog & Pony Studios',
      'Ejercicio de implementación frontend con Nuxt, Tailwind CSS y Jest.',
      'Nuxt · Tailwind CSS · Jest',
      'Abrir vista previa'
    ],
    [
      'Desafío frontend · 2020',
      'Doc88',
      'Ejercicio de implementación frontend con Vue, TypeScript, Tailwind CSS y Jest.',
      'Vue 2.6 · TypeScript · Tailwind CSS · Jest',
      'Abrir vista previa'
    ]
  ],
  pt: [
    [
      'Código aberto histórico · 2020',
      'Nuxt image extractor',
      'Desenvolvi um módulo Nuxt para sites estáticos. Ele baixa imagens de um CMS e atualiza as referências das páginas para arquivos locais. Criado para o projeto da Matera; o repositório está arquivado.',
      'Nuxt · Node.js · Geração estática',
      'Código e documentação'
    ],
    [
      'Demo pública · 2025',
      'Trace CDR',
      'Demo interativa de visualização de dados com React, d3.js e TanStack Query. Explore a interface na prévia pública.',
      'React 19 · TypeScript · Tailwind CSS · d3.js · TanStack Query',
      'Abrir demo'
    ],
    [
      'Desafio frontend · 2020',
      'Dog & Pony Studios',
      'Exercício de implementação frontend com Nuxt, Tailwind CSS e Jest.',
      'Nuxt · Tailwind CSS · Jest',
      'Abrir prévia'
    ],
    [
      'Desafio frontend · 2020',
      'Doc88',
      'Exercício de implementação frontend com Vue, TypeScript, Tailwind CSS e Jest.',
      'Vue 2.6 · TypeScript · Tailwind CSS · Jest',
      'Abrir prévia'
    ]
  ]
}
const links = [
  'https://github.com/d1urno/nuxt-image-extractor',
  'https://preview.tracecdr-demo.pages.dev/',
  'https://dps-senior-frontend-test.netlify.app',
  'https://doc88-frontend-challenge.netlify.app'
]
const thumbnails = [undefined, traceCdrThumbnail, dogAndPonyThumbnail, doc88Thumbnail]
const thumbnailLabel = { en: 'Preview of', es: 'Vista previa de', pt: 'Prévia de' }[locale]
const traceLiveSite = {
  href: 'https://www.tracecdr.org',
  label: {
    en: 'Visit live site',
    es: 'Visitar sitio publicado',
    pt: 'Visitar site publicado'
  }[locale]
}
---

<section aria-labelledby="projects-heading">
  {compact ? (
    <h2 class="sr-only" id="projects-heading">
      {t('projectTitle')}
    </h2>
  ) : (
    <h1 class="sr-only" id="projects-heading">
      {t('projectTitle')}
    </h1>
  )}
  <div class="project-list">
    {projects[locale].slice(0, compact ? 2 : undefined).map((project, index) => {
      const thumbnail = thumbnails[index]
      const actions = [{ href: links[index], label: project[4] }]
      if (project[1] === 'Trace CDR') actions.push(traceLiveSite)
      return (
        <article class:list={['project-item', { 'project-item-with-thumbnail': thumbnail }]}>
          {thumbnail && (
            <Image
              src={thumbnail}
              alt={`${thumbnailLabel} ${project[1]}`}
              class="project-thumbnail"
              width={640}
              widths={[192, 384, 640, 1280]}
              sizes="(min-width: 640px) 192px, calc(100vw - 3rem)"
              format="webp"
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="project-content">
            <p class="eyebrow">{project[0]}</p>
            {compact ? <h3 class="text-xl font-bold">{project[1]}</h3> : <h2>{project[1]}</h2>}
            <p>{project[2]}</p>
            <p class="project-stack">{project[3]}</p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
              {actions.map((action) => (
                <a
                  class="secondary-link"
                  data-text={`${action.label} \u00a0↗`}
                  href={action.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="animated-link-label">
                    {action.label}
                    <span aria-hidden="true">{' \u00a0↗'}</span>
                  </span>
                  <span class="sr-only"> — {project[1]}</span>
                </a>
              ))}
            </div>
          </div>
        </article>
      )
    })}
  </div>
</section>

<style>
  .project-list > .project-item:first-child {
    border-top: 0;
    padding-top: 0;
  }
</style>
