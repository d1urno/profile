---
import { getLocale } from '@/functions/getLocale'
import useTranslations from '@/functions/useTranslations'
import { getProjects } from '@/data/projects'
import ProjectCard from '@/components/ProjectCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
const locale = getLocale(Astro.url)
const { t, translations } = await useTranslations(locale)
const projects = getProjects(translations.Projects).slice(0, compact ? 2 : undefined)
const thumbnailLabel = t('Projects.thumbnailLabel')
---

<section aria-labelledby="projects-heading">
  <SectionHeading as={compact ? 'h2' : 'h1'} id="projects-heading" hidden>
    {t('projectTitle')}
  </SectionHeading>
  <div class="grid gap-6">
    {projects.map((project) => (
      <ProjectCard project={project} thumbnailLabel={thumbnailLabel} compact={compact} />
    ))}
  </div>
</section>
