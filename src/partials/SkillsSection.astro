---
import useTranslations from '@/functions/useTranslations'
import { getLocale } from '@/functions/getLocale'
import { skillGroups } from '@/data/skills'
const { t } = await useTranslations(getLocale(Astro.url))
const groups = skillGroups.map(({ label, skills }) => ({
  title: t(`SkillsSection.${label}`),
  skills
}))
---

<section aria-labelledby="skills-heading">
  <h1 class="sr-only" id="skills-heading">
    {t('SkillsSection.title')}
  </h1>
  <p class="mb-8 leading-7">{t('SkillsSection.text')}</p>
  <div class="grid gap-8 sm:grid-cols-2">
    {groups.map((group) => (
      <section>
        <>
          <h2 class="mb-3 font-semibold">{group.title}</h2>
          <ul class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <li class="rounded-[0.3rem] border border-stone-300 px-[0.7rem] py-[0.4rem] dark:border-slate-400">
                {skill}
              </li>
            ))}
          </ul>
        </>
      </section>
    ))}
  </div>
</section>
