---
import useTranslations from '@/functions/useTranslations'
import { getLocale } from 'astro-i18n-aut'
const { t } = await useTranslations(getLocale(Astro.url))
const groups = [
  {
    title: t('SkillsSection.subtitle1'),
    skills: [
      'TypeScript',
      'JavaScript',
      'SQL',
      'GraphQL',
      'CSS / SCSS',
      'Java',
      'PHP',
      'Python',
      'Go'
    ]
  },
  {
    title: t('SkillsSection.subtitle2'),
    skills: [
      'Vue 3',
      'Nuxt',
      'Tailwind CSS',
      'React',
      'Material UI',
      'Recharts',
      'Node.js',
      'NestJS',
      'Apollo Client / Server',
      'TanStack',
      'Prisma',
      'Astro',
      'Laravel'
    ]
  },
  {
    title: t('SkillsSection.subtitle3'),
    skills: [
      'PostgreSQL',
      'MongoDB',
      'FaunaDB',
      'Open Banking APIs',
      'OpenAI API',
      'Local-first',
      'Mapbox',
      'pnpm monorepos',
      'Headless Drupal',
      'd3.js'
    ]
  },
  {
    title: t('SkillsSection.subtitle4'),
    skills: [
      'Cloudflare',
      'Docker',
      'Firebase',
      'Netlify',
      'DigitalOcean',
      'GCP',
      'AWS',
      'Vercel',
      'CI/CD'
    ]
  }
]
---

<section aria-labelledby="skills-heading">
  <h1 class="section-heading" id="skills-heading">{t('SkillsSection.title')}</h1>
  <p class="mb-8 leading-7">{t('SkillsSection.text')}</p>
  <div class="grid gap-8 sm:grid-cols-2">
    {
      groups.map((group) => (
        <section>
          <>
            <h2 class="mb-3 font-semibold">{group.title}</h2>
            <ul class="skill-list">
              {group.skills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </>
        </section>
      ))
    }
  </div>
</section>
