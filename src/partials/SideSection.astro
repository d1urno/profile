---
import { getLocale, getPagePath } from '@/functions/getLocale'
import useTranslations from '@/functions/useTranslations'
import ThemeSwitcher from '@/components/ThemeSwitcher.vue'
import Icon from '@/components/Icon.astro'
const locale = getLocale(Astro.url)
const { t } = await useTranslations(locale)
const speaking = { spanish: 'native', english: 'fluent', portuguese: 'fluent', german: 'beginner' }
const currentPath = getPagePath(Astro.url)
const locales = ['en', 'es', 'pt'].filter((value) => value !== locale)
---

<aside class="sidebar" aria-label={t('contact')}>
  <div class="toolbar">
    <ThemeSwitcher client:load label={t('ThemeSwitcher.label')}>
      <Icon name="sun" slot="sun-icon" class="h-5 w-5" />
      <Icon name="moon" slot="moon-icon" class="h-5 w-5" />
    </ThemeSwitcher>
    {
      locales.map((loc) => (
        <a
          lang={loc}
          hreflang={loc}
          href={loc === 'en' ? currentPath : '/' + loc + (currentPath === '/' ? '' : currentPath)}
        >
          {t(loc)}
        </a>
      ))
    }
  </div>
  <div class="identity">
    <img
      class="sidebar-photo"
      src="/img/pic_w_320.jpg"
      width="320"
      height="320"
      alt="Pablo Miceli"
      fetchpriority="high"
    />
    <div>
      <p class="identity-name">Pablo Miceli</p>
      <p class="identity-role">{t('SideSection.title')}</p>
    </div>
  </div>
  <div class="contact-details">
    <p>{t('locationValue')}</p>
    <a href="mailto:d1urno@gmx.com">d1urno@gmx.com</a>
  </div>
  <div class="social-links">
    <a href="https://github.com/d1urno" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href="https://www.linkedin.com/in/pmicel/" target="_blank" rel="noopener noreferrer"
      >LinkedIn</a
    >
  </div>
  <a
    class="button"
    href={'/' + t('SideSection.link') + '.pdf'}
    download={`Pablo_Miceli_Senior_Full_Stack_Engineer_${locale.toUpperCase()}.pdf`}
    >{t('SideSection.download')}</a
  >
  <div class="mt-8">
    <h2 class="mb-3 font-semibold">{t('SideSection.idioms')}</h2>
    <ul class="language-list">
      {
        Object.entries(speaking).map(([language, level]) => (
          <li>
            {t('SideSection.' + language)} · {t('SideSection.' + level)}
          </li>
        ))
      }
    </ul>
  </div>
</aside>
