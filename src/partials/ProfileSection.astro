---
import { getLocale } from 'astro-i18n-aut'
import { getEntry } from 'astro:content'
const locale = getLocale(Astro.url)
const profile = await getEntry('locales', locale + '/profile')
if (!profile) throw new Error('Missing profile: ' + locale)
const { Content } = await profile.render()
---

<section aria-labelledby="profile-heading">
  <h1 id="profile-heading" class="eyebrow mb-4">{profile.data.title}</h1>
  <div class="profile-copy prose dark:prose-invert max-w-none"><Content /></div>
</section>
