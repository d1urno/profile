---
import { getLocale } from '@/functions/getLocale'
import Prose from '@/components/Prose.astro'
import { getEntry, render } from 'astro:content'
const locale = getLocale(Astro.url)
const profile = await getEntry('profiles', locale + '/profile')
if (!profile) throw new Error('Missing profile: ' + locale)
const { Content } = await render(profile)
---

<section aria-labelledby="profile-heading">
  <h1 id="profile-heading" class="sr-only">
    {profile.data.title}
  </h1>
  <Prose class="profile-copy text-lg leading-[1.75] [&>p:first-child]:text-[clamp(1.5rem,3vw,2.15rem)] [&>p:first-child]:leading-[1.4] [&>p:first-child]:font-[550] [&>p:first-child]:tracking-[-0.025em]">
    <Content />
  </Prose>
</section>
