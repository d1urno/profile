---
import { getLocale } from '@/functions/getLocale'
import Prose from '@/components/Prose.astro'
import useTranslations from '@/functions/useTranslations'
import { getEntry, render } from 'astro:content'

const locale = getLocale(Astro.url)
const score = await getEntry('scores', `${locale}/score`)

if (!score) {
  throw new Error(`Score content not found for locale "${locale}"`)
}

const { data } = score
const { Content } = await render(score)
const { t } = await useTranslations(locale)
const snapshotNote = t('Score.snapshotNote')
---

<section class="print:mt-10" aria-labelledby="score-heading">
  <h1 id="score-heading" class="sr-only">
    {data.title}
  </h1>
  <Prose class="prose-lg mb-4 print:prose-base">
    <Content />
  </Prose>
  <a
    class="mx-auto mb-8 block text-center text-teal-800 dark:text-teal-300"
    href="https://pagespeed.web.dev/analysis/https-pablomiceli-dev/c0fimw1u0t?form_factor=mobile"
    target="_blank"
    rel="noopener nofollow"
  >
    <img
      class="mx-auto h-auto max-w-full object-contain"
      height="275"
      width="832"
      src="/img/score-2024.jpg"
      alt={data.score}
      loading="lazy"
    />
  </a>
  <p class="text-sm text-slate-600 dark:text-slate-300">{snapshotNote}</p>
</section>
