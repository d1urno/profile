---
import { getLocale } from '@/functions/getLocale'
import { getEntry, render } from 'astro:content'

const locale = getLocale(Astro.url)
const score = await getEntry('locales', `${locale}/score`)

if (!score) {
  throw new Error(`Score content not found for locale "${locale}"`)
}

const { data } = score
const { Content } = await render(score)
const snapshotNote = {
  en: 'Saved PageSpeed snapshot. Open the report for details.',
  es: 'Captura guardada de PageSpeed. Abre el informe para ver los detalles.',
  pt: 'Captura salva do PageSpeed. Abra o relatório para ver os detalhes.'
}[locale]
---

<section class="print:mt-10" aria-labelledby="score-heading">
  <h1 id="score-heading" class="sr-only">
    {data.title}
  </h1>
  <div class="prose dark:prose-invert prose-lg print:prose-base mb-4 max-w-none">
    <Content />
  </div>
  <a
    class="mx-auto mb-8 block text-center text-teal-700 dark:text-white"
    href="https://pagespeed.web.dev/analysis/https-pablomiceli-dev/c0fimw1u0t?form_factor=mobile"
    target="_blank"
    rel="noopener nofollow"
  >
    <img
      class="mx-auto h-auto max-w-full object-contain"
      height="275"
      width="832"
      src="/img/score-2024.jpg"
      alt={data.score}
      loading="lazy"
    />
  </a>
  <p class="text-sm text-slate-600 dark:text-slate-300">{snapshotNote}</p>
</section>
