---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'a'> {
  label: string
  arrow?: '→' | '↗'
  variant?: 'text' | 'action' | 'tab'
  context?: string
}

const { label, arrow, variant = 'text', context, class: className, ...attributes } = Astro.props
const suffix = arrow ? (arrow === '↗' ? ' \u00a0' : ' ') + arrow : ''
---

<a
  {...attributes}
  data-text={label + suffix}
  class:list={[
    'animated-link',
    variant === 'action' &&
      'secondary-link inline-flex min-h-11 items-center before:inset-y-auto before:top-1/2 before:h-[1.5em] before:[transform:translateY(-50%)]',
    variant === 'tab' &&
      'inline-flex min-h-11 items-center py-1 text-base leading-[1.25] font-bold text-slate-600 uppercase no-underline before:inset-y-auto before:top-1/2 before:h-[1.25em] before:[transform:translateY(-50%)] aria-[current=page]:border-b-[3px] aria-[current=page]:border-teal-700 aria-[current=page]:text-teal-900 dark:text-slate-300 dark:aria-[current=page]:border-teal-300 dark:aria-[current=page]:text-teal-200',
    className
  ]}
>
  {arrow ? (
    <span class="animated-link-label">
      {label}
      <span aria-hidden="true">{suffix}</span>
    </span>
  ) : (
    label
  )}
  {context && <span class="sr-only"> — {context}</span>}
</a>
