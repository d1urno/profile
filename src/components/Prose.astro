---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'>
const { class: className, 'class:list': classList, ...attributes } = Astro.props
---

<div
  {...attributes}
  class:list={[
    'prose max-w-none [--tw-prose-body:#334155] [--tw-prose-headings:#0f172a] prose-a:text-teal-800 prose-a:underline prose-a:underline-offset-4 prose-a:[overflow-wrap:anywhere] print:prose-a:text-[#17212f] print:prose-a:no-underline dark:prose-invert dark:[--tw-prose-body:#cbd5e1] dark:[--tw-prose-headings:#f8fafc] dark:[--tw-prose-bold:#f8fafc] dark:[--tw-prose-links:#5eead4] dark:prose-a:text-teal-300 dark:print:prose-a:text-[#17212f]',
    className,
    classList
  ]}
>
  <slot />
</div>
